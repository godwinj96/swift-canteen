# Supabase Postgres connection strings.
# Get these from your Supabase project: Project Settings -> Database -> Connection string
#   DATABASE_URL = "Transaction" pooler connection (port 6543, ?pgbouncer=true) - used at runtime
#   DIRECT_URL   = "Session"/direct connection (port 5432) - used by `prisma migrate`
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres"

AUTH_SECRET="replace-with-a-32+char-random-secret"
BACHS_API_KEY="bachs_placeholder_key"
BACHS_SECRET_KEY="bachs_placeholder_secret_key"
BACHS_PUBLIC_KEY="bachs_placeholder_public_key"
BACHS_WEBHOOK_SECRET="bachs_placeholder_webhook_secret"
BACHS_BASE_URL="https://api.bachs.io"
APP_URL="http://localhost:3000"
